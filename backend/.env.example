# Goldito backend — copy to .env and fill in (never commit .env)
# Names match docs/plan/phases/architecture.ko.md §4

APP_ENV=local
APP_TIMEZONE=America/Toronto
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NEBIUS_API_KEY=
# Vision: handoff photo check (06B), captions + album category (09), report photos (07), label OCR (08). See docs/plan/phases/notes/model-ids.md
MODEL_VISION=openbmb/MiniCPM-V-4_5
MODEL_VISION_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
MODEL_SAFETY=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_SAFETY_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
MODEL_REPORT=nvidia/nemotron-3-super-120b-a12b
MODEL_REPORT_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_FAST_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Embeddings for RAG (phase 07B / 07C) — pgvector vector(1024)
MODEL_EMBED=Qwen/Qwen3-Embedding-8B
MODEL_EMBED_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_EMBED_DIM=1024

# Tavily — web search for treat safety (Phase 8/11). https://tavily.com → API Keys
# Runtime call required for Best Use of Tavily ($3k). Not used in frontend.
TAVILY_API_KEY=

# Demo accounts (scripts/seed_demo.py) — demo-only value, shared with judges; never a real password.
# Use the same value as EXPO_PUBLIC_DEMO_PASSWORD in frontend/.env (Try demo buttons).
DEMO_PASSWORD=

# Video Meet & Greet (3B.11, D45) — the Goldito Google account's OAuth client + refresh token
# (scope https://www.googleapis.com/auth/calendar.events, consent screen published "In production").
# How to get them: docs/plan/env-setup.ko.md § Google Meet. Empty = no Meet links, the app falls back to time + .ics.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# false = Meet links only, no invite emails (demo .test addresses never get one)
MEET_INVITE_ATTENDEES=true
