# PawNote backend — copy to .env and fill in (never commit .env)
# Names match docs/plan/phases/architecture.ko.md §4

APP_ENV=local
APP_TIMEZONE=America/Toronto
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NEBIUS_API_KEY=
MODEL_VISION=nvidia/nemotron-3-nano-omni
MODEL_VISION_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
MODEL_SAFETY=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_SAFETY_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
MODEL_REPORT=nvidia/nemotron-3-super-120b-a12b
MODEL_REPORT_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_FAST_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily — web search for treat safety (Phase 8/11). https://tavily.com → API Keys
# Runtime call required for Best Use of Tavily ($3k). Not used in frontend.
TAVILY_API_KEY=
