{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "goldito-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd \"$(git rev-parse --show-toplevel)/frontend\" && npx expo start --web --port 8081"
      ],
      "port": 8081
    },
    {
      "name": "goldito-api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd \"$(git rev-parse --show-toplevel)/backend\" && .venv/bin/python -m uvicorn app.main:app --port 8000"
      ],
      "port": 8000
    }
  ]
}
